PORT=5000
NODE_ENV=development

# Get this from MongoDB Atlas → Connect → Drivers → Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/healthcare_wellness?retryWrites=true&w=majority

# Generate a strong secret: use any random 32+ character string
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
